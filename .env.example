# ---- ESPN authentication (needed for PRIVATE leagues) ----
# How to get these two values from your browser (Chrome/Firefox/Safari):
#   1. Log in to https://fantasy.espn.com and open one of your leagues
#   2. Open DevTools (Cmd+Option+I) -> Application tab (Chrome) / Storage tab (Firefox)
#   3. Expand Cookies -> https://fantasy.espn.com
#   4. Copy the VALUE of the cookie named  espn_s2   (long, contains % signs)
#   5. Copy the VALUE of the cookie named  SWID      (looks like {AAAA-BBBB-...})
# Safari: Develop menu -> Show Web Inspector -> Storage -> Cookies.
# Paste espn_s2 exactly as-is (do not URL-decode it). Keep the braces on SWID.
ESPN_S2=
ESPN_SWID={00000000-0000-0000-0000-000000000000}

# ---- Season ----
# The NFL season year (the year the season STARTS). e.g. 2025 for the 2025-26 season.
SEASON=2025
# Optional: force which season's game logs feed projections. Leave blank to auto-pick
# (uses SEASON once it has >=1 week of games, otherwise falls back to SEASON-1).
STATS_SEASON=
# Optional: force the NFL week. Leave blank to auto-detect from the schedule
# (first week that still has a game in the future).
WEEK=

# ---- Leagues ----
# Add one block per league. Numbering must be contiguous starting at 1.
LEAGUE_1_ID=123456
LEAGUE_1_TEAM_ID=4
LEAGUE_1_NAME=Work League

LEAGUE_2_ID=789012
LEAGUE_2_TEAM_ID=9
LEAGUE_2_NAME=College Friends League

# ---- Email delivery (Gmail SMTP) ----
# Create an App Password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled). Paste the 16-char password, no spaces.
GMAIL_ADDRESS=tvance100@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_TO=tvance100@gmail.com
# Set to 1 to actually send; 0 just writes the HTML report to ./reports/
EMAIL_ENABLED=0
